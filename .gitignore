# Standard Rails gitignore + control-plane specifics.
/.bundle
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/storage/*
!/storage/.keep
/db/*.sqlite3
/db/*.sqlite3-*
/.env
/.env.*
!/.env.example
/coverage/
/node_modules
.DS_Store

# carbide2-client tree is provided by the meta-repo or a symlink, never tracked here
clients/

