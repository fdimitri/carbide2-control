# Copy to .env for local dev (out-of-cluster).

# Postgres for the control-plane DB. In dev, point at a local pg.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=carbide
POSTGRES_PASSWORD=carbide
POSTGRES_DB=carbide_control_development

# JWT secret. MUST match the workspace-jwt Secret value in cluster.
CARBIDE_JWT_SECRET=dev-fallback-secret-do-not-use-in-prod

# Workspace pod image the operator will spawn.
WORKSPACE_IMAGE=carbide2
WORKSPACE_IMAGE_TAG=dev

# Public URL base the dashboard hands to redirects.
PUBLIC_URL_BASE=http://localhost:8080

# Namespace where Workspace CRs live (the operator watches this namespace).
CONTROL_NAMESPACE=carbide-system

# CORS — comma-separated origins, or * for dev wide-open.
ALLOWED_ORIGINS=*
