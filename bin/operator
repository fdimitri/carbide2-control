#!/usr/bin/env ruby
# bin/operator — entrypoint for the carbide2 Workspace operator.
#
# Watches Workspace CRs (carbide.dev/v1) and reconciles each one into the
# matching K8s resources (Namespace, Deployment, Service, PVC, IngressRoute,
# Secret, ServiceAccount, RoleBinding, CNPG Database). See operator/DESIGN.md
# for the model; operator/workspace_reconciler.rb for the loop.
#
# Boots WITHOUT the full Rails stack — the operator doesn't need
# ActiveRecord, controllers, or routes. It just needs gem autoload + our
# lib/ and operator/ trees.

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
Bundler.require(:default)

$stdout.sync = true
$stderr.sync = true

# Add lib/ and operator/ to the load path so requires Just Work.
ROOT = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(ROOT, "lib"))
$LOAD_PATH.unshift(File.join(ROOT, "operator"))

require "logger"
require "workspace_reconciler"

logger = Logger.new($stdout)
logger.level = ENV.fetch("LOG_LEVEL", "INFO").upcase

namespace = ENV.fetch("CONTROL_NAMESPACE", "carbide-system")
logger.info "[operator] starting — watching Workspace CRs in namespace #{namespace}"

reconciler = Operator::WorkspaceReconciler.new(logger: logger, namespace: namespace)

%w[INT TERM].each do |sig|
  Signal.trap(sig) do
    # Logger.write isn't trap-safe. Just flip the flag; the run! loop
    # will print + exit cleanly.
    reconciler.stop!
  end
end

reconciler.run!
